---
import type { ServiceFAQ } from "../data/services/types";

interface Props {
  items: ServiceFAQ[];
}

const { items } = Astro.props;
---

<div class="divide-y divide-white/25 border-y border-white/25">
  {
    items.map((item) => (
      <details class="faq-item" name="service-faq">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-5 py-5 text-left">
          <span class="heading-sm font-medium text-cream">{item.question}</span>
          <span class="faq-icon relative h-5 w-5 shrink-0" aria-hidden="true">
            <span class="absolute left-0 top-1/2 h-0.5 w-5 -translate-y-1/2 bg-secondary" />
            <span class="faq-icon-vertical absolute left-1/2 top-0 h-5 w-0.5 -translate-x-1/2 bg-secondary" />
          </span>
        </summary>
        <p class="max-w-2xl pb-5 pr-8 leading-7 text-cream">{item.answer}</p>
      </details>
    ))
  }
</div>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] .faq-icon-vertical {
    transform: translateX(-50%) scaleY(0);
  }
</style>
