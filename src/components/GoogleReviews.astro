---
import Container from "./Container.astro";

const reviewUrl = "https://maps.app.goo.gl/STVoahmY5AnreL4X8";
---

<section
  aria-labelledby="google-reviews-heading"
  class="px-4 py-12 sm:px-8 sm:py-16 lg:px-10"
>
  <Container
    className="flex flex-col items-start justify-between gap-8 rounded-2xl bg-primary p-7 shadow-md sm:p-10 md:flex-row md:items-center lg:p-12"
  >
    <div class="max-w-2xl">
      <p
        class="text-xs font-semibold uppercase tracking-[0.2em] text-primary-200"
      >
        Google Reviews
      </p>
      <h2 id="google-reviews-heading" class="heading-lg mt-3 text-white">
        Had a great experience?
      </h2>
      <p class="mt-4 text-sm leading-6 text-white/80 sm:text-base sm:leading-8">
        We’d love to hear what you think. Leave us a review on Google and help
        others discover Aastha Furniture.
      </p>
    </div>

    <a
      href={reviewUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex shrink-0 items-center gap-3 rounded-lg bg-white px-6 py-4 font-semibold text-primary transition-colors hover:bg-primary-50"
      aria-label="Write a Google review for Aastha Furniture (opens in a new tab)"
    >
      <svg
        aria-hidden="true"
        class="h-6 w-6"
        viewBox="0 0 24 24"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M21.6 12.23c0-.72-.06-1.42-.18-2.1H12v3.97h5.38a4.6 4.6 0 0 1-2 3.02v2.57h3.23c1.89-1.74 2.99-4.3 2.99-7.46Z"
          fill="#4285F4"></path>
        <path
          d="M12 22c2.7 0 4.97-.9 6.62-2.43l-3.23-2.57c-.9.6-2.04.96-3.39.96-2.6 0-4.8-1.75-5.59-4.1H3.08v2.65A10 10 0 0 0 12 22Z"
          fill="#34A853"></path>
        <path
          d="M6.41 13.86a6.02 6.02 0 0 1 0-3.72V7.49H3.08a10 10 0 0 0 0 9.02l3.33-2.65Z"
          fill="#FBBC05"></path>
        <path
          d="M12 6.04c1.47 0 2.79.5 3.82 1.5l2.87-2.87A9.6 9.6 0 0 0 12 2a10 10 0 0 0-8.92 5.49l3.33 2.65c.79-2.35 2.99-4.1 5.59-4.1Z"
          fill="#EA4335"></path>
      </svg>
      <span>Write a Google review</span>
    </a>
  </Container>
</section>
