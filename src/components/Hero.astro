---
import type { ServiceHeroContent } from "../data/services/types";
import { Phone, ArrowRight } from "@lucide/astro";

interface Props {
  content: ServiceHeroContent;
}

const { content } = Astro.props;
const imageSource =
  typeof content.image === "string" ? content.image : content.image.desktop;
const responsiveImage =
  typeof content.image === "string" ? undefined : content.image;
---

<section
  class="relative flex h-[60vh] min-h-[600px] items-center justify-center overflow-hidden"
>
  <picture class="absolute inset-0 h-full w-full">
    {
      responsiveImage && (
        <source
          type="image/webp"
          srcset={`${responsiveImage.mobile} 640w, ${responsiveImage.tablet} 1024w, ${responsiveImage.desktop} 1600w`}
          sizes="100vw"
        />
      )
    }
    <img
      src={imageSource}
      alt=""
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </picture>

  <!-- Overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/45 to-black/30"
  >
  </div>

  <!-- Content -->
  <div class="container relative z-10 mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Tagline -->
      <span
        class="mb-6 inline-flex rounded-full border border-white/20 bg-white/10 px-5 py-2 text-xs font-medium tracking-[0.3em] uppercase text-white backdrop-blur"
      >
        {content.eyebrow}
      </span>

      <h1 class="display text-cream heading-lg pb-4">
        {content.heading}
      </h1>

      <p class="lead text-white/90">
        {content.description}
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap justify-center gap-4 mt-10">
        <a
          href={content.primaryButton.href}
          class="btn btn-primary btn-lg btn-icon-right"
        >
          <ArrowRight />
          {content.primaryButton.label}
        </a>

        <a href={content.secondaryButton.href} class="btn btn-secondary btn-lg">
          <Phone class="h-5 w-5" />
          {content.secondaryButton.label}
        </a>
      </div>
    </div>
  </div>
</section>
