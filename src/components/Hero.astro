---
import type { ServiceHeroContent } from "../data/services/types";
import { Phone, ArrowRight, Mail } from "@lucide/astro";

interface Props {
  content: ServiceHeroContent;
}

const { content } = Astro.props;
const getButtonIcon = (href: string) =>
  href.startsWith("/contact")
    ? Mail
    : href.startsWith("/")
      ? ArrowRight
      : Phone;
const PrimaryIcon = getButtonIcon(content.primaryButton?.href ?? "");
const SecondaryIcon =
  content.secondaryButton.icon === "email"
    ? Mail
    : getButtonIcon(content.secondaryButton.href);
const imageSource =
  typeof content.image === "string" ? content.image : content.image.desktop;
const responsiveImage =
  typeof content.image === "string" ? undefined : content.image;
---

<section
  class="relative mt-20 flex h-[60vh] min-h-[600px] items-center justify-center overflow-hidden"
>
  <picture class="absolute inset-0 h-full w-full">
    {
      responsiveImage && (
        <source
          type="image/webp"
          srcset={`${responsiveImage.mobile} 640w, ${responsiveImage.tablet} 1024w, ${responsiveImage.desktop} 1600w`}
          sizes="100vw"
        />
      )
    }
    <img
      src={imageSource}
      alt={content.imageAlt ?? ""}
      class="h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
  </picture>

  <!-- Overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/45 to-black/30"
  >
  </div>

  <!-- Content -->
  <div class="container relative z-10 mx-auto max-w-7xl px-6">
    <div class="mx-auto max-w-4xl text-center">
      <!-- Tagline -->
      <span
        class="mb-6 inline-flex rounded-full border border-white/20 bg-white/10 px-5 py-1 text-xs font-medium tracking-[0.3em] uppercase text-white backdrop-blur"
      >
        {content.eyebrow}
      </span>

      <h1 class="display text-cream heading-lg pb-2">
        {content.heading}
      </h1>

      <p class="subtitle text-cream">
        {content.description}
      </p>

      <!-- Buttons -->
      <div class="flex flex-wrap justify-center gap-4 mt-5">
        {
          content.primaryButton && (
            <a
              href={content.primaryButton.href}
              class="btn btn-primary btn-lg btn-icon-right"
            >
              <PrimaryIcon />
              {content.primaryButton.label}
            </a>
          )
        }

        <a href={content.secondaryButton.href} class="btn btn-secondary btn-lg">
          <SecondaryIcon class="h-5 w-5" />
          {content.secondaryButton.label}
        </a>
      </div>
    </div>
  </div>
</section>
