---
import { Phone } from "@lucide/astro";
---

<nav aria-label="Quick contact" class="mobile-contact-buttons">
  <a
    href="https://wa.me/919310244463"
    aria-label="Chat with us on WhatsApp"
    class="mobile-contact-button mobile-contact-button--whatsapp"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
      class="h-7 w-7"
    >
      <path
        d="M20.1 3.9A11.4 11.4 0 0 0 2.16 17.65L.8 22.6l5.07-1.33A11.4 11.4 0 0 0 20.1 3.9Z"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.8"
      />
      <path
        d="M8.25 7.3c-.24-.54-.5-.55-.73-.56h-.62c-.22 0-.57.08-.87.4-.3.33-1.14 1.12-1.14 2.74s1.17 3.18 1.33 3.4c.16.21 2.25 3.6 5.55 4.9 2.75 1.09 3.31.87 3.9.82.6-.05 1.92-.79 2.19-1.55.27-.77.27-1.43.19-1.57-.08-.14-.3-.22-.65-.4-.34-.16-1.92-.95-2.22-1.05-.3-.11-.52-.16-.73.16-.22.33-.84 1.05-1.03 1.27-.19.22-.38.24-.73.08-.35-.17-1.45-.54-2.77-1.72-1.02-.91-1.71-2.03-1.91-2.38-.2-.35-.02-.53.15-.7.15-.15.35-.38.52-.57.17-.19.23-.33.34-.55.12-.22.06-.41-.02-.57-.08-.16-.73-1.77-1-2.42Z"
        fill="currentColor"
      />
    </svg>
  </a>

  <a
    href="tel:+919310244463"
    aria-label="Call 9310244463"
    class="mobile-contact-button mobile-contact-button--call"
  >
    <Phone aria-hidden="true" class="h-6 w-6" />
  </a>
</nav>

<style>
  .mobile-contact-buttons {
    position: fixed;
    z-index: 50;
    right: 1rem;
    bottom: calc(1rem + env(safe-area-inset-bottom));
    left: 1rem;
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .mobile-contact-button {
    display: inline-flex;
    width: 3.5rem;
    height: 3.5rem;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    color: white;
    box-shadow: 0 4px 14px rgb(0 0 0 / 22%);
    pointer-events: auto;
    transition:
      transform 180ms ease,
      box-shadow 180ms ease;
  }

  .mobile-contact-button:hover {
    color: white;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgb(0 0 0 / 28%);
  }

  .mobile-contact-button:focus-visible {
    outline: 3px solid white;
    outline-offset: 3px;
  }

  .mobile-contact-button--whatsapp {
    background-color: #25d366;
  }

  .mobile-contact-button--call {
    background-color: var(--color-primary);
  }

  @media (min-width: 768px) {
    .mobile-contact-buttons {
      display: none;
    }
  }
</style>
