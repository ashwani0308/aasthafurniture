---
interface Props {
  eyebrow: string;
  heading: string;
  subtext?: string;
  headingId?: string;
  align?: "center" | "left";
  className?: string;
  subtextClassName?: string;
}

const {
  eyebrow,
  heading,
  subtext,
  headingId,
  align = "center",
  className = "",
  subtextClassName = "",
} = Astro.props;
---

<header
  class:list={[
    "section-title mb-4 md:mb-6 sm:mb-2 flex flex-col gap-1",
    align === "center"
      ? "items-center pt-6 text-center"
      : "items-start text-left",
    { "section-title--left": align === "left" },
    className,
  ]}
>
  <span
    class="inline-block rounded-full pt-1 pb-0 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
  >
    {eyebrow}
  </span>
  <h2 id={headingId} class="heading-lg">{heading}</h2>
  {
    subtext && (
      <p
        class:list={[
          "subtitle",
          { "text-center": align === "center" },
          subtextClassName,
        ]}
      >
        {subtext}
      </p>
    )
  }
</header>

<style>
  .section-title--left {
    max-width: none;
    margin-inline: 0;
    text-align: left;
  }

  .section-title--left :global(.subtitle) {
    margin-inline: 0;
  }
</style>
