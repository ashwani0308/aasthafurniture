---
interface Props {
  heading: string;
  subheading: string;
  buttonLabel: string;
  href: string;
}

const { heading, subheading, buttonLabel, href } = Astro.props;
---

<article
  class="flex aspect-[4/5] w-full flex-col items-start rounded-xl bg-primary p-6 text-cream shadow-sm transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl sm:p-7 lg:p-6 xl:p-8"
>
  <div>
    <h3
      class="text-balance font-[var(--font-heading)] text-2xl font-semibold leading-tight text-cream sm:text-2xl md:text-3xl lg:text-4xl"
    >
      {heading}
    </h3>
    <p class="mt-4 leading-7 text-cream/85">{subheading}</p>
  </div>
  <a href={href} class="btn btn-secondary btn-md mt-auto">
    {buttonLabel}
  </a>
</article>
