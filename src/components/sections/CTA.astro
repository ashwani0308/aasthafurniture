---
import { Phone, ArrowRight } from "@lucide/astro";
import Container from "../Container.astro";
---

<section class="px-4 py-8 sm:px-8 lg:px-10">
  <Container
    maxWidth="1400px"
    className="relative flex min-h-[400px] items-center justify-center overflow-hidden rounded-[0.8rem] md:rounded-[1rem] lg:rounded-[1.5rem]"
  >
    <!-- Background Image -->
    <img
      src="/images/cta/cta-bg.jpg"
      alt="CTA background"
      class="absolute inset-0 h-full w-full object-cover"
    />

    <!-- Overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-black/70 via-black/45 to-black/30"
    >
    </div>

    <!-- Content -->
    <div class="relative z-10 mx-auto w-full max-w-7xl px-6">
      <div class="mx-auto max-w-4xl text-center">
        <h2 class="heading-lg text-cream">Browse Furniture Categories</h2>

        <p class="subtitle text-cream">
          Discover handcrafted furniture designed for every room.
        </p>

        <!-- Buttons -->
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/gallery" class="btn btn-primary btn-lg">
            View Collection
            <ArrowRight class="h-5 w-5" />
          </a>

          <a href="tel:+919999999999" class="btn btn-secondary btn-lg">
            <Phone class="h-5 w-5" />
            Call Now
          </a>
        </div>
      </div>
    </div>
  </Container>
</section>
