---
import { Phone, ArrowRight } from "@lucide/astro";
import Container from "../Container.astro";
---

<section class="px-4 py-8 sm:px-8 lg:px-10">
  <!-- ===================================================== -->
  <!-- CTA -->
  <!-- ===================================================== -->

  <Container>
    <div
      class="flex flex-col items-center justify-between gap-2 py-2 text-center md:flex-row md:items-center md:text-left"
    >
      <div>
        <span
          class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
          >Premium Furniture Manufacturer</span
        >

        <h2 class="heading-lg mt-0 color-heading">
          Your Space. Your Style. Our Craft.
        </h2>

        <p
          class="mt-4 max-w-xl text-base leading-7 text-slate-700 sm:mt-6 sm:text-lg sm:leading-8 md:max-w-xl"
        >
          Explore our furniture collection and talk to us about finding the
          right pieces for your home or business.
        </p>
      </div>

      <div
        class="flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row sm:flex-wrap md:justify-end"
      >
        <a
          href="/contact"
          class="btn btn-secondary btn-lg btn-icon-right w-full sm:w-auto"
        >
          Get Free Quote
          <ArrowRight />
        </a>

        <a
          href="tel:+919999999999"
          class="btn btn-primary btn-lg w-full sm:w-auto"
        >
          <Phone />
          Call Now
        </a>
      </div>
    </div>
  </Container>
</section>
