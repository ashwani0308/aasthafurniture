---
import { Phone, Mail, MapPin, Clock3, ArrowRight } from "@lucide/astro";
import Container from "../Container.astro";
import { furnitureCategories } from "../../data/furniture.ts";
---

<!-- ===================================================== --><!-- Main Footer --><!-- ===================================================== -->
<footer class="bg-[var(--color-primary-900)] text-cream">
  <div class="px-4 sm:px-8 lg:px-10">
    <Container className="py-20">
      <div
        class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-12 lg:grid-cols-12 lg:gap-14"
      >
        <!-- ================================================= -->
        <!-- Company -->
        <!-- ================================================= -->

        <div class="sm:col-span-2 lg:col-span-4">
          <a
            href="/"
            class="inline-flex rounded bg-cream px-4 py-2"
          >
            <img
              src="/images/brand/aastha_furniture.svg"
              alt="Aastha Furniture"
              class="h-auto w-52"
            />
          </a>

          <p class="mt-8 max-w-md leading-4 text-white/70">
            Woodsy is a premium furniture manufacturer creating handcrafted
            furniture for homes, offices and commercial spaces.
          </p>

          <div class="mt-10 space-y-5">
            <div class="flex items-start gap-3">
              <MapPin class="mt-1 h-5 w-5 shrink-0 text-secondary" />

              <span class="text-white/70">
                Furniture Market,
                <br />
                Noida, Uttar Pradesh, India
              </span>
            </div>

            <a
              href="tel:+919999999999"
              class="flex items-center gap-3 text-white/70 transition hover:text-secondary"
            >
              <Phone class="h-5 w-5 shrink-0 text-secondary" />

              +91 99999 99999
            </a>

            <a
              href="mailto:hello@woodsy.in"
              class="flex items-center gap-3 text-white/70 transition hover:text-secondary"
            >
              <Mail class="h-5 w-5 shrink-0 text-secondary" />

              hello@woodsy.in
            </a>
          </div>
        </div>

        <!-- ================================================= -->
        <!-- Furniture Categories -->
        <!-- ================================================= -->

        <div class="lg:col-span-2">
          <h3 class="heading-sm text-cream">Furniture</h3>

          <ul class="mt-8 space-y-4">
            {
              furnitureCategories.map((category) => (
                <li>
                  <a
                    href={`/furniture/${category.slug}`}
                    class="text-white/70 transition hover:text-secondary"
                  >
                    {category.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- ================================================= -->
        <!-- Quick Links -->
        <!-- ================================================= -->

        <div class="lg:col-span-2">
          <h3 class="heading-sm text-cream">Quick Links</h3>

          <ul class="mt-8 space-y-4">
            <li>
              <a
                href="/"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Home
              </a>
            </li>

            <li>
              <a
                href="/about"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                About Us
              </a>
            </li>

            <li>
              <a
                href="/services"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Services
              </a>
            </li>

            <li>
              <a
                href="/gallery"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Gallery
              </a>
            </li>

            <li>
              <a
                href="/blog"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Blog
              </a>
            </li>

            <li>
              <a
                href="/contact"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Contact
              </a>
            </li>
          </ul>
        </div>

        <!-- ================================================= -->
        <!-- Our Services -->
        <!-- ================================================= -->

        <div class="lg:col-span-2">
          <h3 class="heading-sm text-cream">Our Services</h3>

          <ul class="mt-8 space-y-4">
            <li>
              <a
                href="/custom-furniture"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Custom Furniture
              </a>
            </li>

            <li>
              <a
                href="/modular-kitchen"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Modular Kitchen
              </a>
            </li>

            <li>
              <a
                href="/interior-furniture"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Home Interior
              </a>
            </li>

            <li>
              <a
                href="/office-furniture"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Office Furniture
              </a>
            </li>

            <li>
              <a
                href="/wardrobe-design"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Wardrobe Design
              </a>
            </li>

            <li>
              <a
                href="/delivery-installation"
                class="text-white/70 transition duration-300 hover:text-secondary"
              >
                Delivery & Installation
              </a>
            </li>
          </ul>
        </div>

        <!-- ================================================= -->
        <!-- Follow Us -->
        <!-- ================================================= -->

        <div class="lg:col-span-2">
          <h3 class="heading-sm text-cream">Follow Us</h3>

          <p class="mt-8 leading-7 text-white/70">
            Follow us for our latest furniture collections, completed projects
            and design inspiration.
          </p>

          <div class="mt-8 flex gap-4">
            <!-- Facebook -->
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-white/5 transition-all duration-300 hover:-translate-y-1 hover:border-secondary hover:bg-secondary"
            >
              <svg
                class="h-5 w-5 fill-current"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.23.19 2.23.19v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.77l-.44 2.89h-2.33v6.99A10 10 0 0 0 22 12z"
                ></path>
              </svg>
            </a>

            <!-- Instagram -->
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-white/5 transition-all duration-300 hover:-translate-y-1 hover:border-secondary hover:bg-secondary"
            >
              <svg
                class="h-5 w-5 fill-current"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M7.75 2C4.57 2 2 4.57 2 7.75v8.5C2 19.43 4.57 22 7.75 22h8.5C19.43 22 22 19.43 22 16.25v-8.5C22 4.57 19.43 2 16.25 2h-8.5zm0 2h8.5A3.75 3.75 0 0 1 20 7.75v8.5A3.75 3.75 0 0 1 16.25 20h-8.5A3.75 3.75 0 0 1 4 16.25v-8.5A3.75 3.75 0 0 1 7.75 4zm8.75 1a1.25 1.25 0 1 0 0 2.5 1.25 1.25 0 0 0 0-2.5zM12 7a5 5 0 1 0 5 5 5 5 0 0 0-5-5zm0 2a3 3 0 1 1-3 3 3 3 0 0 1 3-3z"
                ></path>
              </svg>
            </a>

            <!-- YouTube -->
            <a
              href="#"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="flex h-12 w-12 items-center justify-center rounded-full border border-white/10 bg-white/5 transition-all duration-300 hover:-translate-y-1 hover:border-secondary hover:bg-secondary"
            >
              <svg
                class="h-5 w-5 fill-current"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M23.5 6.2a2.97 2.97 0 0 0-2.09-2.1C19.57 3.6 12 3.6 12 3.6s-7.57 0-9.41.5A2.97 2.97 0 0 0 .5 6.2 31.7 31.7 0 0 0 0 12a31.7 31.7 0 0 0 .5 5.8 2.97 2.97 0 0 0 2.09 2.1c1.84.5 9.41.5 9.41.5s7.57 0 9.41-.5a2.97 2.97 0 0 0 2.09-2.1A31.7 31.7 0 0 0 24 12a31.7 31.7 0 0 0-.5-5.8zM9.75 15.5v-7l6 3.5-6 3.5z"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </Container>
  </div>

  <!-- ===================================================== -->
  <!-- Bottom Footer -->
  <!-- ===================================================== -->

  <div class="border-t border-white/10 px-4 sm:px-8 lg:px-10">
    <Container>
      <div
        class="flex flex-col items-center justify-between gap-6 py-8 lg:flex-row"
      >
        <!-- Copyright -->

        <div class="text-center lg:text-left">
          <p class="text-sm text-white/60">
            © {new Date().getFullYear()}
            <span class="font-medium text-white"> Woodsy </span>

            All Rights Reserved.
          </p>
        </div>

        <!-- Policies -->

        <nav>
          <ul
            class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2"
          >
            <li>
              <a
                href="/privacy-policy"
                class="text-sm text-white/60 transition duration-300 hover:text-secondary"
              >
                Privacy Policy
              </a>
            </li>

            <li>
              <a
                href="/terms-and-conditions"
                class="text-sm text-white/60 transition duration-300 hover:text-secondary"
              >
                Terms & Conditions
              </a>
            </li>

            <li>
              <a
                href="/sitemap.xml"
                class="text-sm text-white/60 transition duration-300 hover:text-secondary"
              >
                Sitemap
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </Container>
  </div>
</footer>
