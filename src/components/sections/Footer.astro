---
import { Phone, Mail, MapPin, Clock3, Globe } from "@lucide/astro";
import Container from "../Container.astro";
import { furnitureCategories } from "../../data/furniture.ts";
---

<!-- ===================================================== --><!-- Main Footer --><!-- ===================================================== -->
<footer class="bg-[var(--color-primary-900)] text-cream">
  <div class="px-4 sm:px-8 lg:px-10">
    <Container className="py-14">
      <div
        class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-12 lg:grid-cols-12 lg:gap-14"
      >
        <!-- ================================================= -->
        <!-- Company -->
        <!-- ================================================= -->

        <div class="sm:col-span-2 lg:col-span-4">
          <a href="/" class="inline-flex">
            <img
              src="/images/brand/aastha_furniture_light.svg"
              alt="Aashta Furniture"
              class="h-auto w-52"
            />
          </a>

          <div class="mt-4 space-y-5">
            <div class="flex items-start gap-3">
              <MapPin class="mt-1 h-5 w-5 shrink-0 text-secondary" />

              <p class="text-white/70">
                Basanti Lane, Dewan Road
                <br />
                Muzaffarpur, Bihar 842001, India
              </p>
            </div>

            <a
              href="tel:+919310244463"
              class="footer-link flex items-center gap-3 transition"
            >
              <Phone class="h-5 w-5 shrink-0 text-secondary" />

              +91 93102 44463
            </a>

            <a
              href="https://aasthafurniture.in"
              class="footer-link flex items-center gap-3 transition"
            >
              <Globe class="h-5 w-5 shrink-0 text-secondary" />

              aasthafurniture.in
            </a>

            <a
              href="mailto:hello@woodsy.in"
              class="footer-link flex items-center gap-3 transition"
            >
              <Mail class="h-5 w-5 shrink-0 text-secondary" />

              info@aasthafurniture.in
            </a>
          </div>
        </div>

        <!-- ================================================= -->
        <!-- Furniture Categories -->
        <!-- ================================================= -->

        <div class="lg:col-span-2">
          <h3 class="heading-sm text-cream">Furniture</h3>

          <ul class="mt-4 space-y-2">
            {
              furnitureCategories.map((category) => (
                <li>
                  <a
                    href={`/furniture/${category.slug}`}
                    class="footer-link transition"
                  >
                    {category.title.replace(/^Wooden\s+/, "")}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- ================================================= -->
        <!-- Quick Links -->
        <!-- ================================================= -->

        <div class="lg:col-span-2">
          <h3 class="heading-sm text-cream">Quick Links</h3>

          <ul class="mt-4 space-y-2">
            <li>
              <a href="/" class="footer-link transition duration-300"> Home </a>
            </li>

            <li>
              <a href="/about" class="footer-link transition duration-300">
                About Us
              </a>
            </li>

            <li>
              <a href="/contact" class="footer-link transition duration-300">
                Contact
              </a>
            </li>
          </ul>
        </div>

        <!-- ================================================= -->
        <!-- Our Services -->
        <!-- ================================================= -->

        <div class="lg:col-span-2">
          <h3 class="heading-sm text-cream">Our Services</h3>

          <ul class="mt-4 space-y-2">
            <li>
              <a
                href="/service/custom-made-furniture"
                class="footer-link transition duration-300"
              >
                Custom-Made Furniture
              </a>
            </li>

            <li>
              <a
                href="/service/bulk-wholesale-furniture"
                class="footer-link transition duration-300"
              >
                Bulk & Wholesale Furniture
              </a>
            </li>

            <li>
              <a
                href="/service/furniture-repair-restoration"
                class="footer-link transition duration-300"
              >
                Furniture Repair & Restoration
              </a>
            </li>
          </ul>
        </div>

      </div>
    </Container>
  </div>

  <!-- ===================================================== -->
  <!-- Bottom Footer -->
  <!-- ===================================================== -->

  <div class="border-t border-white/10 px-4 sm:px-8 lg:px-10">
    <Container>
      <div
        class="flex flex-col items-center justify-between gap-6 py-8 lg:flex-row"
      >
        <!-- Copyright -->

        <div class="text-center lg:text-left">
          <p class="text-sm text-white/60">
            © {new Date().getFullYear()}
            <span class="font-medium text-white"> Aashta Furniture </span>

            All Rights Reserved.
          </p>
        </div>

        <!-- Policies -->

        <nav>
          <ul
            class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2"
          >
            <li>
              <a
                href="/privacy-policy"
                class="footer-link text-sm transition duration-300"
              >
                Privacy Policy
              </a>
            </li>

            <li>
              <a
                href="/terms-and-conditions"
                class="footer-link text-sm transition duration-300"
              >
                Terms & Conditions
              </a>
            </li>

            <li>
              <a
                href="/sitemap.xml"
                class="footer-link text-sm transition duration-300"
              >
                Sitemap
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </Container>
  </div>
</footer>
