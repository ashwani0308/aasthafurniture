---
import { ArrowRight } from "@lucide/astro";
import Container from "../Container.astro";
---

<section class="px-4 py-12 sm:px-8 lg:px-10 bg-white">
  <Container className="flex flex-col overflow-hidden lg:flex-row">
    <div class="flex lg:w-1/2">
      <img
        src="/images/hero/hero-2.jpg"
        alt="Custom-made furniture showcase"
        class="h-full min-h-125 w-full object-cover rounded-[0.8rem] md:rounded-2xl lg:rounded-3xl"
      />
    </div>

    <div
      class="flex flex-col justify-center p-8 sm:p-10 lg:w-1/2 lg:p-14 xl:p-16"
    >
      <!-- <span class="subtitle">Bespoke Design</span> -->
      <h2 class="heading-lg">Made at the Source</h2>

      <p class="subtitle">
        From selecting materials to the final finish, every piece goes through
        our hands.
      </p>

      <div class="mt-8">
        <a href="/contact" class="btn btn-primary btn-lg">
          Book a Consultation
          <ArrowRight class="h-5 w-5" />
        </a>
      </div>
    </div>
  </Container>
</section>
