---
import Container from "../Container.astro";
import SectionHeading from "../SectionHeading.astro";
import type { AboutImageTextContent } from "../../data/about";

interface Props {
  content: AboutImageTextContent;
}

const { content } = Astro.props;
---

<section class="px-4 py-12 sm:px-8 lg:px-10 bg-white">
  <Container className="flex flex-col overflow-hidden lg:flex-row">
    <div class="flex lg:w-1/2">
      <img
        src={content.image.src}
        alt={content.image.alt}
        class="h-full min-h-125 w-full object-cover rounded-[0.8rem] md:rounded-2xl lg:rounded-3xl"
      />
    </div>

    <div
      class="flex flex-col justify-center p-8 sm:p-10 lg:w-1/2 lg:p-14 xl:p-16"
    >
      <SectionHeading
        eyebrow={content.eyebrow}
        heading={content.heading}
        align="left"
        className="mb-4"
      />
      <div class="space-y-4">
        {
          content.paragraphs.map((paragraph) => (
            <p class="subtitle">{paragraph}</p>
          ))
        }
      </div>
      {
        content.services && (
          <div class="mt-6 space-y-4">
            {content.services.map((service, index) => (
              <div
                class:list={[
                  "border-b border-gray-200 pb-4",
                  { "border-t pt-4": index === 0 },
                ]}
              >
                <h3 class="heading-lg mt-2 pb-3 text-xl sm:text-2xl md:text-3xl lg:text-4xl">
                  {service.heading}
                </h3>
                <p class="subtitle">{service.description}</p>
              </div>
            ))}
          </div>
        )
      }
      {
        content.closingParagraphs?.map((paragraph, index) => (
          <p class:list={["subtitle mt-4", { "font-semibold": index === 1 }]}>
            {paragraph}
          </p>
        ))
      }
    </div>
  </Container>
</section>
