---
import { instagramContent } from "../../data/instagram";

interface Props {
  instagramUrl?: string;
}

const { instagramUrl = instagramContent.instagramUrl } = Astro.props;
---

<section
  class="section-background overflow-hidden pb-4 pt-16 sm:pb-4 bg-white"
  aria-labelledby="instagram-heading"
>
  <div class="container-custom mb-8 text-center">
    <span
      class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
      >{instagramContent.eyebrow}</span
    >
    <h2 id="instagram-heading" class="heading-lg mt-2">
      {instagramContent.heading}
    </h2>
    <p class="subtitle mt-2">
      {instagramContent.description}
    </p>
  </div>

  <div class="instagram-slider__viewport overflow-hidden">
    <div class="instagram-slider__container">
      {
        instagramContent.images.map((image) => (
          <div class="instagram-slider__slide">
            <a
              class="instagram-slider__link group relative block aspect-square overflow-hidden"
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={image.ariaLabel}
            >
              <img
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
                src={image.src}
                alt={image.alt}
                loading="lazy"
              />
              <span class="instagram-slider__overlay" aria-hidden="true">
                <svg
                  class="h-10 w-10"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r=".75" fill="currentColor" />
                </svg>
              </span>
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import EmblaCarousel from "embla-carousel";
  import AutoScroll from "embla-carousel-auto-scroll";

  function initInstagramSliders() {
    document
      .querySelectorAll<HTMLElement>(".instagram-slider__viewport")
      .forEach((viewport) => {
        if (viewport.dataset.init === "true") return;
        viewport.dataset.init = "true";

        const prefersReducedMotion = window.matchMedia(
          "(prefers-reduced-motion: reduce)",
        ).matches;
        const autoScroll = AutoScroll({
          speed: 0.5,
          startDelay: 0,
          stopOnInteraction: false,
          stopOnMouseEnter: false,
          playOnInit: !prefersReducedMotion,
        });

        EmblaCarousel(
          viewport,
          {
            align: "start",
            containScroll: false,
            dragFree: true,
            loop: true,
          },
          [autoScroll],
        );
      });
  }

  initInstagramSliders();
  document.addEventListener("astro:page-load", initInstagramSliders);
</script>

<style>
  .instagram-slider__container {
    display: flex;
    touch-action: pan-y pinch-zoom;
  }

  .instagram-slider__slide {
    flex: 0 0 33.333333%;
    min-width: 0;
    padding-inline: 0.5rem;
  }

  .instagram-slider__link:focus-visible {
    outline: 3px solid var(--color-secondary);
    outline-offset: -3px;
  }

  .instagram-slider__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--color-primary);
    color: white;
    opacity: 0;
    transition:
      opacity 250ms ease,
      background-color 250ms ease;
  }

  .instagram-slider__link:hover .instagram-slider__overlay,
  .instagram-slider__link:focus-visible .instagram-slider__overlay {
    opacity: 0.88;
  }

  @media (min-width: 640px) {
    .instagram-slider__slide {
      flex-basis: 26%;
    }
  }

  @media (min-width: 1024px) {
    .instagram-slider__slide {
      flex-basis: 25%;
    }
  }

  @media (min-width: 1280px) {
    .instagram-slider__slide {
      flex-basis: 12.5%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-slider__link img,
    .instagram-slider__overlay {
      transition: none;
    }
  }
</style>
