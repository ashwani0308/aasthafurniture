---
import Container from "../Container.astro";
import { testimonialContent } from "../../data/testimonials";
---

<section class="px-4 py-16 sm:px-8 sm:py-20 lg:px-10">
  <Container
    className="grid grid-cols-1 items-center gap-10 md:grid-cols-2 md:gap-12 lg:gap-16"
  >
    <div>
      <span class="eyebrow">{testimonialContent.eyebrow}</span>
      <h2 class="heading-lg mt-0 pb-6">{testimonialContent.heading}</h2>
      <p class="subtitle mt-4 max-w-xl">
        {testimonialContent.description}
      </p>
    </div>

    <div
      class="elfsight-app-3109ff50-86ba-49ce-a557-784da415245f w-full"
      data-elfsight-app-lazy
    >
    </div>
  </Container>
</section>

<style>
  .es-review-background-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
    border: 0;
    background-color: rgba(255, 255, 255, 0) !important;
  }
</style>

<script is:inline src="https://elfsightcdn.com/platform.js" async></script>
<script is:inline>
  document.querySelectorAll(".es-background-container a").forEach((anchor) => {
    anchor.replaceWith(...anchor.childNodes);
  });
</script>
