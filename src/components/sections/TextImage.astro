---
import { ArrowRight } from "@lucide/astro";
import Container from "../Container.astro";
---

<section class="px-4 py-16 sm:px-8 lg:px-10">
  <Container className="flex flex-col overflow-hidden lg:flex-row">
    <div
      class="flex flex-col justify-center p-8 sm:p-10 lg:w-1/2 lg:p-14 xl:p-16"
    >
      <span class="subtitle">Bespoke Design</span>
      <h2 class="heading-lg">Browse Furniture Categories</h2>

      <p class="subtitle">
        Discover handcrafted furniture designed for every room.
      </p>

      <div class="mt-8">
        <a href="/contact" class="btn btn-primary btn-lg">
          Book a Consultation
          <ArrowRight class="h-5 w-5" />
        </a>
      </div>
    </div>
    <div class="lg:w-1/2">
      <img
        src="/images/hero/hero-2.jpg"
        alt="Custom-made furniture showcase"
        class="h-full min-h-[500px] w-full object-cover rounded-[0.8rem] md:rounded-[1rem] lg:rounded-[1.5rem]"
      />
    </div>
  </Container>
</section>
