---
import Container from "../Container.astro";
import type { FactoryDirectContent } from "../../data";

interface Props {
  content: FactoryDirectContent;
}

const { content } = Astro.props;
---

<section
  class="section-background text-image-section bg-white px-4 py-8 sm:px-8 lg:px-10"
>
  <Container
    className="relative z-10 flex flex-col gap-10 overflow-hidden sm:gap-4 md:gap-8 lg:flex-row lg:gap-16"
  >
    <div class="flex flex-col justify-center lg:w-1/2">
      <span
        class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
        >{content.eyebrow}</span
      >

      <h2 class="heading-lg pb-3">{content.heading}</h2>

      <p class="subtitle text-md">
        {content.description}
      </p>
      <div class="mt-6 space-y-4">
        {
          content.features.map((feature, index) => (
            <div
              class:list={[
                "border-b border-gray-200 pb-4",
                { "border-t pt-4": index === 0 },
              ]}
            >
              <h3 class="heading-lg pb-3 text-xl sm:text-2xl md:text-3xl lg:text-4xl mt-2">
                {feature.heading}
              </h3>
              <p class="subtitle">{feature.description}</p>
            </div>
          ))
        }
      </div>
    </div>
    <div class="flex lg:w-1/2">
      <img
        src={content.image.src}
        alt={content.image.alt}
        class="h-full min-h-125 w-full object-contain"
      />
    </div>
  </Container>
</section>
