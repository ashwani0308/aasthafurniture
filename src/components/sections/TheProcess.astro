---
import Container from "../Container.astro";
import { Phone } from "@lucide/astro";

const processSteps = [
  {
    number: "1",
    heading: "Tell Us Your Vision",
    description:
      "Share your ideas, space requirements, preferred style, and inspiration. We'll start by understanding what matters most to you.",
  },
  {
    number: "2",
    heading: "Shape the Design",
    description:
      "Fine-tune the dimensions, design, materials, and finishes to create furniture that feels right for your space.",
  },
  {
    number: "3",
    heading: "Choose Your Details",
    description:
      "Explore wood options, colours, textures, and finishing touches to give your furniture its own distinctive character.",
  },
  {
    number: "4",
    heading: "Crafted with Care",
    description:
      "Our craftsmen bring your approved design to life, paying attention to construction, details, and quality of finish.",
  },
  {
    number: "5",
    heading: "Made for Your Space",
    description:
      "Your finished furniture is ready to become part of your home or business. Arrange delivery or collection according to your agreed requirements.",
  },
];
---

<section
  class="relative isolate bg-cover bg-center bg-fixed px-4 py-12 sm:px-8 sm:py-16 lg:px-10 lg:py-20"
  style="background-image: url('/images/cta/cta-bg.jpg');"
>
  <div aria-hidden="true" class="absolute inset-0 bg-primary opacity-85"></div>
  <Container
    className="relative z-10 grid grid-cols-1 items-stretch gap-8 md:grid-cols-3 md:gap-10 lg:gap-14"
  >
    <div
      class="relative aspect-[4/3] overflow-hidden rounded-xl md:col-span-1 md:aspect-auto md:min-h-[500px]"
    >
      <img
        src="/images/hero/slider_image_2_1024.webp"
        alt="Furniture crafted for a welcoming home"
        class="absolute inset-0 h-full w-full object-cover object-center"
        loading="lazy"
      />
    </div>

    <div class="md:col-span-2">
      <span
        class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
        >DESIGNED AROUND YOU</span
      >
      <h2 class="heading-lg text-cream">Custom Furniture, Made Simple</h2>
      <p class="subtitle mt-4 max-w-2xl text-cream">
        Every space is different, and your furniture should be too. Our simple
        four-step process takes you from your initial idea to furniture crafted
        around your requirements.
      </p>

      <div
        class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-2"
      >
        {
          processSteps.map((step) => (
            <article>
              <p class="heading-lg font-semibold leading-none text-secondary sm:text-4xl">
                {step.number}
              </p>
              <h3 class="heading-lg pb-3 leading-none text-xl sm:text-2xl md:text-3xl lg:text-4xl mt-2 text-cream">
                {step.heading}
              </h3>
              <p class="subtitle mt-2 text-cream">{step.description}</p>
            </article>
          ))
        }
        <article
          class="rounded-xl flex flex-col bg-white p-6 gap-3 text-center sm:flex sm:justify-between sm:gap-3 sm:text-left"
        >
          <div>
            <h3 class="heading-sm text-primary">Let's Talk About Your Ideas</h3>
            <p class="subtitle mt-2 text-slate-700">
              Call us to discuss your requirements
            </p>
          </div>
          <a
            href="tel:+919999999999"
            class="btn btn-secondary btn-md mt-2 w-full sm:mt-0 sm:w-auto"
          >
            <Phone />
            Call Us Now
          </a>
        </article>
      </div>
    </div>
  </Container>
</section>
