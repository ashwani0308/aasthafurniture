---
import Container from "../Container.astro";
import { Phone } from "@lucide/astro";

const processSteps = [
  {
    number: "1",
    heading: "Share Your Ideas",
    description:
      "Tell us about your space, preferred style, dimensions, and how you plan to use the furniture.",
  },
  {
    number: "2",
    heading: "Plan Your Design",
    description:
      "Discuss the design, materials, finishes, and practical details to shape your furniture.",
  },
  {
    number: "3",
    heading: "Craft with Care",
    description:
      "Your furniture is crafted to the agreed specifications, with attention to detail and finish.",
  },
  {
    number: "4",
    heading: "Ready for Your Space",
    description:
      "Your finished furniture is prepared for delivery or collection, as agreed.",
  },
  {
    number: "5",
    heading: "Ready for Your Space",
    description:
      "Your finished furniture is prepared for delivery or collection, as agreed.",
  },
];
---

<section
  class="relative isolate bg-cover bg-center bg-fixed px-4 py-12 sm:px-8 sm:py-16 lg:px-10 lg:py-20"
  style="background-image: url('/images/cta/cta-bg.jpg');"
>
  <div aria-hidden="true" class="absolute inset-0 bg-primary opacity-85"></div>
  <Container
    className="relative z-10 grid grid-cols-1 items-stretch gap-8 md:grid-cols-3 md:gap-10 lg:gap-14"
  >
    <div class="relative min-h-[500px] md:col-span-1">
      <img
        src="/images/hero/hero-2.jpg"
        alt="Furniture crafted for a welcoming home"
        class="absolute inset-0 h-auto md:h-full w-full rounded-2xl object-cover h-[inherit]"
        loading="lazy"
      />
    </div>

    <div class="md:col-span-2">
      <span
        class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
        >DESIGNED AROUND YOU</span
      >
      <h2 class="heading-lg text-cream">Custom Furniture, Made Simple</h2>
      <p class="subtitle mt-4 max-w-2xl text-cream">
        Every space is different, and your furniture should be too. Our simple
        four-step process takes you from your initial idea to furniture crafted
        around your requirements.
      </p>

      <div class="mt-3 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:gap-2">
        {
          processSteps.map((step) => (
            <article>
              <p class="heading-md font-semibold leading-none text-secondary sm:text-3xl">
                {step.number}
              </p>
              <h3 class="heading-md mt-2 text-cream">{step.heading}</h3>
              <p class="subtitle mt-2 text-cream">{step.description}</p>
            </article>
          ))
        }
        <article
          class="rounded-2xl flex flex-col bg-white p-6 gap-3 text-center sm:flex sm:justify-between sm:gap-3 sm:text-left"
        >
          <div>
            <h3 class="heading-sm text-primary">Let's Talk About Your Ideas</h3>
            <p class="subtitle mt-2 text-slate-700">
              Call us to discuss your requirements
            </p>
          </div>
          <a
            href="tel:+919999999999"
            class="btn btn-secondary btn-md mt-2 w-full sm:mt-0 sm:w-auto"
          >
            <Phone />
            Call Us Now
          </a>
        </article>
      </div>
    </div>
  </Container>
</section>
