---
import Container from "../Container.astro";
import { Phone } from "@lucide/astro";

const processSteps = [
  {
    number: "1",
    heading: "Share Your Ideas",
    description:
      "Tell us what you need, your preferred style, dimensions, and budget. We'll understand your requirements before getting started.",
  },
  {
    number: "2",
    heading: "Finalise Your Design",
    description:
      "Discuss the design, dimensions, and layout to create furniture that fits your space and matches your style.",
  },
  {
    number: "3",
    heading: "Choose Materials & Finishes",
    description:
      "Select suitable wood, colours, textures, and finishing details to give your furniture the look you want.",
  },
  {
    number: "4",
    heading: "Crafted with Care",
    description:
      "Our skilled craftsmen bring your design to life with attention to construction, detailing, and finishing.",
  },
  {
    number: "5",
    heading: "Ready for Your Space",
    description:
      "Your custom-made furniture is ready for your home or business. Arrange delivery or collection as agreed.",
  },
];
---

<section
  class="process-background relative isolate bg-cover bg-center bg-fixed px-4 py-12 sm:px-8 sm:py-16 lg:px-10 lg:py-20"
>
  <div aria-hidden="true" class="absolute inset-0 bg-primary opacity-92"></div>
  <Container
    className="relative z-10 grid grid-cols-1 items-stretch gap-8 md:grid-cols-3 md:gap-10 lg:gap-14"
  >
    <div
      role="img"
      aria-label="Furniture crafted for a welcoming home"
      class="process-image relative hidden aspect-[4/3] overflow-hidden rounded-xl md:col-span-1 md:block md:aspect-auto md:min-h-[500px]"
    >
    </div>

    <div class="md:col-span-2">
      <span
        class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
      >
        CUSTOM DESIGNS. PERSONAL TOUCH.
      </span>

      <h2 class="heading-lg text-cream">Your Ideas. Our Craftsmanship.</h2>

      <p class="subtitle mt-4 max-w-2xl text-cream">
        Get wooden furniture designed around your space, style, and needs. From
        choosing the design and materials to expert craftsmanship, we make
        custom furniture simple and personal.
      </p>

      <div
        class="mt-3 grid grid-cols-1 gap-0 sm:grid-cols-2 sm:gap-0 lg:grid-cols-2"
      >
        {
          processSteps.map((step) => (
            <article class="p-4 pt-0 pb-0">
              <p class="heading-xl font-semibold leading-none text-secondary sm:text-2xl md:text-4xl xl:text-5xl">
                {step.number}
              </p>
              <h3 class="heading-lg pb-3 leading-none text-xl sm:text-2xl md:text-3xl lg:text-4xl mt-2 text-cream">
                {step.heading}
              </h3>
              <p class="subtitle mt-2 text-cream">{step.description}</p>
            </article>
          ))
        }<div class="p-x-4 pt-4">
          <article
            class="rounded-xl flex flex-col bg-white p-6 gap-3 text-center sm:flex sm:justify-between sm:gap-3 sm:text-left"
          >
            <div>
              <h3 class="heading-sm text-primary">
                Let's Talk About Your Ideas
              </h3>
              <p class="subtitle mt-2 text-slate-700">
                Call us to discuss your requirements
              </p>
            </div>
            <a
              href="tel:+919310244463"
              class="btn btn-secondary btn-md mt-2 w-full sm:mt-0 sm:w-auto"
            >
              <Phone />
              Call Us Now
            </a>
          </article>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .process-background {
    background-image: url("/images/bg/the-process-640.webp");
  }

  .process-image {
    background: center / cover no-repeat;
  }

  @media (min-width: 768px) {
    .process-image {
      background-image: url("/images/section_image/the_process.webp");
    }
  }

  @media (min-width: 640px) {
    .process-background {
      background-image: url("/images/bg/the-process-1024.webp");
    }
  }

  @media (min-width: 1024px) {
    .process-background {
      background-image: url("/images/bg/the-process-1600.webp");
    }
  }
</style>
