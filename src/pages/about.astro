---
import Hero from "../components/Hero.astro";
import ImageText from "../components/sections/ImageText.astro";
import TextImage from "../components/sections/TextImage.astro";
import CTAText from "../components/sections/CTAText.astro";
import { homepageCtaContent } from "../data";
import {
  aboutPageHead,
  aboutCTAImageContent,
  aboutHeroContent,
  aboutCraftsmanshipContent,
  aboutHeritageContent,
  aboutManufacturingContent,
} from "../data/about";
import MainLayout from "../layouts/MainLayout.astro";
import CTAImageBg from "../components/sections/CTAImageBg.astro";
---

<MainLayout
  title={aboutPageHead.title}
  description={aboutPageHead.description}
>
  <Hero content={aboutHeroContent} />
  <ImageText content={aboutHeritageContent} />
  <CTAText content={homepageCtaContent} />
  <TextImage content={aboutCraftsmanshipContent} />
  <CTAImageBg content={aboutCTAImageContent} />
  <ImageText content={aboutManufacturingContent} />
  <CTAText content={homepageCtaContent} />
</MainLayout>
