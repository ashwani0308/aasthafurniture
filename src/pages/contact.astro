---
import { ArrowRight } from "@lucide/astro";
import Container from "../components/Container.astro";
import Hero from "../components/Hero.astro";
import type { ServiceHeroContent } from "../data/services/types";
import MainLayout from "../layouts/MainLayout.astro";

const contactHeroContent: ServiceHeroContent = {
  eyebrow: "WE'D LOVE TO HEAR FROM YOU",
  heading: "Let's Talk About Your Furniture",
  description:
    "Tell us what you have in mind. Our team is here to help with your furniture questions and project enquiries.",
  image: "/images/hero/slider_image_2_1600.webp",
  secondaryButton: { label: "Call Now", href: "tel:+919310244463" },
};
---

<MainLayout title="Contact">
  <Hero content={contactHeroContent} />
  <section
    class="mx-auto max-w-3xl px-4 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24"
  >
    <Container maxWidth="768px">
      <header class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
        <span
          class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
        >
          GET IN TOUCH
        </span>
        <h2 class="heading-lg text-primary">How can we help?</h2>
        <p class="subtitle mt-4 text-slate-700">
          Share a few details about what you need, and our team will be in touch
          to discuss the next steps.
        </p>
      </header>

      <form
        id="contact-form"
        action="/api/contact"
        method="post"
        class="mx-auto max-w-2xl space-y-5 p-6 sm:p-8"
      >
        <div
          id="contact-form-status"
          class="hidden rounded-md px-4 py-3 text-sm"
          role="status"
          aria-live="polite"
        >
        </div>
        <input
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
          hidden
        />
        <div>
          <label for="name" class="mb-2 block font-medium text-primary">
            Name
          </label>
          <input
            id="name"
            name="name"
            type="text"
            autocomplete="name"
            required
            class="w-full rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
          />
        </div>

        <div>
          <label for="email" class="mb-2 block font-medium text-primary">
            Email
          </label>
          <input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            maxlength="254"
            required
            class="w-full rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
          />
        </div>

        <div>
          <label for="phone" class="mb-2 block font-medium text-primary">
            Phone
          </label>
          <input
            id="phone"
            name="phone"
            type="tel"
            autocomplete="tel"
            required
            class="w-full rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
          />
        </div>

        <div>
          <label for="service" class="mb-2 block font-medium text-primary">
            Service Interested In
          </label>
          <select
            id="service"
            name="service"
            required
            class="w-full rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
          >
            <option value="" disabled selected>Select a service</option>
            <option value="custom-made-furniture">Custom-Made Furniture</option>
            <option value="bulk-wholesale-furniture"
              >Bulk & Wholesale Furniture</option
            >
            <option value="furniture-repair-restoration">
              Furniture Repair & Restoration
            </option>
            <option value="other">Other</option>
          </select>
        </div>

        <div>
          <label for="message" class="mb-2 block font-medium text-primary">
            Message
          </label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="w-full resize-y rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
          ></textarea>
        </div>

        <button
          type="submit"
          class="btn btn-primary btn-lg btn-icon-right w-full sm:w-auto"
        >
          Send Enquiry
          <ArrowRight />
        </button>
      </form>
    </Container>
  </section>
</MainLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  const status = document.querySelector<HTMLDivElement>("#contact-form-status");

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!status || !form) return;

    const submitButton = form.querySelector<HTMLButtonElement>(
      'button[type="submit"]',
    );
    if (submitButton) submitButton.disabled = true;
    status.className = "rounded-md bg-primary/5 px-4 py-3 text-sm text-primary";
    status.textContent = "Sending your enquiry...";
    let failureMessage =
      "We couldn't send your enquiry. Please try again or call us at +91 93102 44463.";

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: new FormData(form),
        headers: { Accept: "application/json" },
      });
      const result: unknown = await response.json().catch(() => null);

      if (!response.ok) {
        if (
          typeof result === "object" &&
          result !== null &&
          "error" in result &&
          typeof result.error === "string"
        ) {
          failureMessage = result.error;
        } else if (response.status === 404 || response.status === 405) {
          failureMessage =
            "The contact form endpoint is not available on this deployment. Redeploy the Cloudflare Pages project with the functions/ directory included. If the problem continues, please call us at +91 93102 44463.";
        }
        throw new Error("The enquiry could not be sent.");
      }

      if (
        typeof result !== "object" ||
        result === null ||
        !("ok" in result) ||
        result.ok !== true
      ) {
        failureMessage =
          "The contact form service returned an unexpected response. Please call us at +91 93102 44463.";
        throw new Error("Unexpected contact form response.");
      }

      form.reset();
      status.className =
        "rounded-md bg-green-50 px-4 py-3 text-sm text-green-800";
      status.textContent =
        "Thank you. Your enquiry has been sent, and our team will be in touch.";
    } catch {
      status.className = "rounded-md bg-red-50 px-4 py-3 text-sm text-red-800";
      status.textContent = failureMessage;
    } finally {
      if (submitButton) submitButton.disabled = false;
    }
  });
</script>
