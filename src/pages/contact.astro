---
import { ArrowRight } from "@lucide/astro";
import Container from "../components/Container.astro";
import Hero from "../components/Hero.astro";
import type { ServiceHeroContent } from "../data/services/types";
import MainLayout from "../layouts/MainLayout.astro";

const contactHeroContent: ServiceHeroContent = {
  eyebrow: "WE'D LOVE TO HEAR FROM YOU",
  heading: "Let's Talk About Your Furniture",
  description:
    "Tell us what you have in mind. Our team is here to help with your furniture questions and project enquiries.",
  image: "/images/hero/slider_image_2_1600.webp",
  primaryButton: { label: "Send an Enquiry", href: "#contact-form" },
  secondaryButton: { label: "Call Now", href: "tel:+919999999999" },
};
---

<MainLayout title="Contact">
  <Hero content={contactHeroContent} />
  <section class="px-4 py-16 sm:px-8 sm:py-20 lg:px-10 lg:py-24">
    <Container>
      <header class="mx-auto mb-10 max-w-3xl text-center sm:mb-14">
        <span
          class="inline-block rounded-full py-2 text-xs font-medium uppercase tracking-[0.2em] text-secondary"
        >
          GET IN TOUCH
        </span>
        <h2 class="heading-lg text-primary">How can we help?</h2>
        <p class="subtitle mt-4 text-slate-700">
          Share a few details about what you need, and our team will be in touch
          to discuss the next steps.
        </p>
      </header>

      <div
        class="grid grid-cols-1 items-stretch gap-8 overflow-hidden md:grid-cols-2 lg:gap-12"
      >
        <div class="h-full min-h-72">
          <img
            src="/images/cta/three-image.webp"
            alt="Thoughtfully crafted furniture for your home"
            class="h-full min-h-72 w-full object-cover md:min-h-0"
            loading="lazy"
          />
        </div>

        <form id="contact-form" class="space-y-5 p-6 sm:p-8 lg:p-10">
          <div>
            <label for="name" class="mb-2 block font-medium text-primary">
              Name
            </label>
            <input
              id="name"
              name="name"
              type="text"
              autocomplete="name"
              required
              class="w-full rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
            />
          </div>

          <div>
            <label for="phone" class="mb-2 block font-medium text-primary">
              Phone
            </label>
            <input
              id="phone"
              name="phone"
              type="tel"
              autocomplete="tel"
              required
              class="w-full rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
            />
          </div>

          <div>
            <label for="service" class="mb-2 block font-medium text-primary">
              Service Interested In
            </label>
            <select
              id="service"
              name="service"
              required
              class="w-full rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
            >
              <option value="" disabled selected>Select a service</option>
              <option value="custom-made-furniture"
                >Custom-Made Furniture</option
              >
              <option value="bulk-wholesale-furniture"
                >Bulk & Wholesale Furniture</option
              >
              <option value="furniture-repair-restoration">
                Furniture Repair & Restoration
              </option>
              <option value="other">Other</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-2 block font-medium text-primary">
              Message
            </label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full resize-y rounded-md border border-primary/20 bg-white px-4 py-3 text-primary outline-none transition focus:border-secondary focus:ring-2 focus:ring-secondary/20"
            ></textarea>
          </div>

          <button
            type="submit"
            class="btn btn-primary btn-lg btn-icon-right w-full sm:w-auto"
          >
            Send Enquiry
            <ArrowRight />
          </button>
        </form>
      </div>
    </Container>
  </section>
</MainLayout>
