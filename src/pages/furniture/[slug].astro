---
import MainLayout from "../../layouts/MainLayout.astro";
import Hero from "../../components/Hero.astro";
import ImageGallery from "../../components/sections/ImageGallery.astro";
import CTAText from "../../components/sections/CTAText.astro";
import TextImage from "../../components/sections/TextImage.astro";
import CTAImageBg from "../../components/sections/CTAImageBg.astro";
import Testimonials from "../../components/sections/Testimonials.astro";
import InstagramSlider from "../../components/sections/InstagramSlider.astro";

import { homepageCTAImageContent, homepageCtaContent } from "../../data";
import { furnitureCategories } from "../../data/furniture.ts";
import type { ServiceHeroContent } from "../../data/services/types";

export function getStaticPaths() {
  return furnitureCategories.map((category) => ({
    params: {
      slug: category.slug,
    },
    props: {
      category,
    },
  }));
}

const { category } = Astro.props;
const heroContent: ServiceHeroContent = {
  eyebrow: "Premium Furniture Since 1998",
  heading: category.title,
  description: category.description,
  image: category.hero.image,
  imageAlt: category.title,
  primaryButton: { label: "View Collection", href: "/gallery" },
  secondaryButton: { label: "Call Now", href: "tel:+919310244463" },
};
const galleryContent = {
  eyebrow: category.gallerySection?.eyebrow ?? "Explore Our Collection",
  heading: category.gallerySection?.heading ?? category.title,
  description: category.gallerySection?.description ?? category.description,
  works: [...category.gallery],
  button: category.ctaImageContent?.primaryButton ?? {
    label: "Contact Us",
    href: "/contact",
  },
};
---

<MainLayout title={category.title}>
  <Hero content={heroContent} />

  {category.gallery.length > 0 && <ImageGallery content={galleryContent} />}

  <CTAText content={homepageCtaContent} />
  {
    category.textImageContent && (
      <TextImage content={category.textImageContent} />
    )
  }
  <Testimonials />
  <CTAImageBg content={category.ctaImageContent ?? homepageCTAImageContent} />
  <InstagramSlider />
</MainLayout>
