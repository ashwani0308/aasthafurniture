---
import MainLayout from "../../layouts/MainLayout.astro";
import CategoryHero from "../../components/furniture/CategoryHero.astro";
import Section from "../../components/Section.astro";
import CategoryCarousel from "../../components/sections/CategoryCarousel.astro";
import TextImage from "../../components/sections/TextImage.astro";
import CTAImageBg from "../../components/sections/CTAImageBg.astro";
import Testimonials from "../../components/sections/Testimonials.astro";
import InstagramSlider from "../../components/sections/InstagramSlider.astro";

import { homepageCTAImageContent } from "../../data";
import { furnitureCategories } from "../../data/furniture.ts";

export function getStaticPaths() {
  return furnitureCategories.map((category) => ({
    params: {
      slug: category.slug,
    },
    props: {
      category,
    },
  }));
}

const { category } = Astro.props;
---

<MainLayout title={category.title}>
  <CategoryHero
    title={category.title}
    subtitle={category.description}
    image={category.hero.image}
  />

  {
    category.subcategories && category.subcategorySection && (
      <Section padding="py-4 sm:py-4 lg:py-6">
        <CategoryCarousel
          items={category.subcategories}
          headingContent={category.subcategorySection}
          autoplay={true}
          autoplayDelay={1500}
          showDots={false}
          loop={true}
        />
      </Section>
    )
  }

  {category.textImageContent && <TextImage content={category.textImageContent} />}
  <Testimonials />
  <CTAImageBg
    content={category.ctaImageContent ?? homepageCTAImageContent}
  />
  <InstagramSlider />
</MainLayout>
